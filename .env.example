# Copie para .env e ajuste. Nunca versione o arquivo .env (ADR-07).
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_SECURE_COOKIES=0
# Deixe POSTGRES_DB vazio para usar SQLite no desenvolvimento local.
POSTGRES_DB=
POSTGRES_USER=acessasus
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Senha dos usuários de demonstração criados por `manage.py seed_demo` (apenas teste).
DEMO_SENHA=Demo@AcessaSUS2026
ACESSASUS_LOG_LEVEL=INFO
